# Copy to .env for local non-Docker runs; docker-compose.yml sets these itself.
#
# SQLite (default; a single file, shareable by several API instances):
DATABASE_URL=sqlite:////tmp/research.db
# PostgreSQL (production; row-lock MVCC concurrency):
# DATABASE_URL=postgresql+psycopg2://research:research@localhost:5432/researchdb

MAX_BUNDLE_ENTRIES=20
IDEMPOTENCY_STALE_SECONDS=60
# SQLite: how long to wait for the writer lock before returning a retryable 503.
SQLITE_BUSY_TIMEOUT_SECONDS=30
# Retries when a concurrent writer invalidates a read snapshot.
DB_BUSY_RETRIES=8
DB_BUSY_BACKOFF_SECONDS=0.02
